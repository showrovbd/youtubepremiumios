{
  "name": "YouTube (10in1 port)",
  "desc": "YouTube ad-skip rules, rewrites and scripts ported from Shadowrocket 10in1 module. Author: Showrov (Loon port). Note: Shadowrocket's UDP-scoped AND reject rules have no Loon equivalent; domain-wide reject would break rewrite/MITM, so those rules are omitted.",
  "author": "Showrov / Loon port",
  "version": "1.0.0",
  "homepage": "https://github.com/duyvinh09/Module_IOS",
  "config": "[Rewrite]\n^https?:\\/\\/[\\w-]+\\.googlevideo\\.com\\/(?!(dclk_video_ads|videoplayback\\?)).+&oad - reject-200\n^https?:\\/\\/(www|s)\\.youtube\\.com\\/api\\/stats\\/ads - reject-200\n^https?:\\/\\/(www|s)\\.youtube\\.com\\/(pagead|ptracking) - reject-200\n^https?:\\/\\/s\\.youtube\\.com\\/api\\/stats\\/qoe\\?adcontext - reject-200\n(^https?:\\/\\/[\\w-]+\\.googlevideo\\.com\\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302\n^https?:\\/\\/[\\w-]+\\.googlevideo\\.com\\/initplayback.+&oad - reject-200\n\n[Script]\nhttp-request ^https:\\/\\/youtubei\\.googleapis\\.com\\/youtubei\\/v1\\/(browse|next|player|reel\\/reel_watch_sequence|get_watch) script-path=https://raw.githubusercontent.com/duyvinh09/Module_IOS/refs/heads/main/js/youtube.response.js, requires-body=true, max-size=-1, binary-body-mode=true\nhttp-response ^https:\\/\\/youtubei\\.googleapis\\.com\\/youtubei\\/v1\\/(browse|next|player|search|reel\\/reel_watch_sequence|guide|account\\/get_setting|get_watch) script-path=https://raw.githubusercontent.com/duyvinh09/Module_IOS/refs/heads/main/js/youtube.response.js, requires-body=true, max-size=-1, binary-body-mode=true, argument=\"{\\\"lyricLang\\\":\\\"vi\\\",\\\"captionLang\\\":\\\"vi\\\",\\\"blockUpload\\\":true,\\\"blockImmersive\\\":true,\\\"debug\\\":false}\"\n\n[MITM]\nhostname = *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, s.youtube.com, -redirector*.googlevideo.com\n"
}
